# Copy to .env (git-ignored). Same code runs in both modes; only these values change.
#   Copy-Item .env.example .env

RUN_MODE=local
AIRFLOW_UID=50000

# ---- azure mode only (fill in after running the azure\*.ps1 scripts) ----------
# AZURE_MYSQL_HOST=de33-mysql-xxxx.mysql.database.azure.com
# AZURE_MYSQL_USER=olistadmin
# AZURE_MYSQL_PASSWORD=
# AZURE_MYSQL_SSL_CA=/opt/project/azure/DigiCertGlobalRootG2.crt.pem
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_COSMOS_ENDPOINT=https://de33-cosmos-xxxx.documents.azure.com:443/
# AZURE_COSMOS_KEY=

# ---- optional knobs ------------------------------------------------------------
# DQ_MAX_BAD_RATIO=0.02      # quality gate: max share of quarantined rows per table
# COSMOS_FAKE=1              # use the in-memory Cosmos fake instead of the emulator
